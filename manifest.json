{
  "manifest_version": 3,
  "name": "B站稍后再看排序",
  "version": "0.8.14",
  "description": "扩展排序融入B站原生下拉菜单，保持原生样式",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.bilibili.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/watchlater*",
        "https://www.bilibili.com/list/watchlater*"
      ],
      "js": [
        "src/sort.js",
        "src/full-native.js",
        "src/native-intercept.js",
        "src/api.js",
        "src/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/watchlater*",
        "https://www.bilibili.com/list/watchlater*"
      ],
      "js": [
        "src/preload.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.bilibili.com/watchlater*",
        "https://www.bilibili.com/list/watchlater*"
      ],
      "js": [
        "src/sort.js",
        "src/date-overlay.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "B站稍后再看排序"
  }
}
