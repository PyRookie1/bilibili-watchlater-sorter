{
  "manifest_version": 3,
  "name": "B站稍后再看排序",
  "version": "0.3.0",
  "description": "在B站稍后再看原页面中获取完整列表，按发布时间或全部分P总时长全量排序",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.bilibili.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/watchlater*",
        "https://www.bilibili.com/list/watchlater*"
      ],
      "js": [
        "src/api.js",
        "src/page-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/watchlater*",
        "https://www.bilibili.com/list/watchlater*"
      ],
      "js": [
        "src/sort.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "稍后再看全量排序"
  }
}
